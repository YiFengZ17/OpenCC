# Add this site to the existing Caddy configuration; keep proxy.opencc.app intact.
# If opencc.app already exists, merge its block rather than adding a duplicate.
# Cloudflare published CIDRs checked 2026-10-24. Refresh before deployment.
opencc.app {
    encode zstd gzip
    header X-Content-Type-Options nosniff
    header Referrer-Policy strict-origin-when-cross-origin
    @private path /api/* /v1/* /setup/*
    header @private Cache-Control "private, no-store"
    @cloudflare remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
    handle @cloudflare {
        reverse_proxy 127.0.0.1:8088 {
            header_up CF-IPCountry {http.request.header.CF-IPCountry}
            flush_interval -1
        }
    }
    handle {
        reverse_proxy 127.0.0.1:8088 {
            header_up -CF-IPCountry
            flush_interval -1
        }
    }
}
