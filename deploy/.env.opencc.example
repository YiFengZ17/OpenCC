# Copy to .env.opencc, chmod 600. Never commit real values.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
TOTP_ENCRYPTION_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# One ledger credit = one CNY point. Do not change after issuing cards.
OPENCC_CNY_PER_CREDIT=1
OPENCC_GATEWAY_URL=https://opencc.app
OPENCC_SUPPORT_URL=
# HTTPS links to card products. Empty links disable purchases.
OPENCC_SHOP_10=
OPENCC_SHOP_50=
OPENCC_SHOP_100=
OPENCC_SHOP_200=
# Upstream keys go into the backend account settings, never VITE_* variables.
