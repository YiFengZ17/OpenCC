# Copy to .env.opencc, chmod 600. Never commit real values.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
TOTP_ENCRYPTION_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Balance denomination: one ledger unit = CNY 1, not Kiro credit. Do not change after issuing balance.
OPENCC_CNY_PER_CREDIT=1
OPENCC_GATEWAY_URL=https://opencc.app
OPENCC_SUPPORT_URL=
# Optional HTTPS links to card products. Empty links disable the buy buttons;
# for a team-only site the admin can top up balances or hand out redeem codes instead.
OPENCC_SHOP_10=
OPENCC_SHOP_50=
OPENCC_SHOP_100=
OPENCC_SHOP_200=
# Upstream keys go into the backend account settings, never VITE_* variables.
